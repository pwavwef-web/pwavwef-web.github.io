# Copy to .env.local (dev) — `npm run web:env` writes .env.production.local from the Firebase project.
# These are public client identifiers; access is enforced by Auth, App Check, security rules and the owner-only API.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=az-learner.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=az-learner
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIRESTORE_DATABASE=az-studio
VITE_MEDIA_BUCKET=az-studio-media-az-learner
VITE_FUNCTIONS_REGION=us-central1
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local development only
VITE_USE_EMULATORS=false
