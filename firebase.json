{
  "firestore": [
    {
      "database": "az-studio",
      "rules": "firebase/generated/firestore.rules",
      "indexes": "firebase/firestore.indexes.json"
    }
  ],
  "storage": [
    {
      "target": "media",
      "rules": "firebase/generated/storage.rules"
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "az-studio",
      "runtime": "nodejs24",
      "ignore": [
        "node_modules",
        ".git",
        "src",
        "test",
        "*.log",
        ".secret.local",
        "tsconfig.json",
        "build.mjs",
        "*.map"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": [
    {
      "target": "studio",
      "public": "apps/web/dist",
      "ignore": [
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "/api/public/**",
          "function": {
            "functionId": "azsPublic",
            "region": "us-central1"
          }
        },
        {
          "source": "/embed/audio/**",
          "destination": "/embed.html"
        },
        {
          "regex": "^/(studio|projects|ads|lite|mvlite|linkad|narrator|create|jobs|settings|print|home)(/.*)?$",
          "destination": "/studio.html"
        },
        {
          "source": "/assets",
          "destination": "/studio.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=63072000; includeSubDomains; preload"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
            },
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin-allow-popups"
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://apis.google.com https://www.gstatic.com; frame-src 'self' https://az-learner.firebaseapp.com https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/ https://accounts.google.com; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://*.run.app https://www.google.com/recaptcha/ https://storage.googleapis.com https://firebasestorage.googleapis.com https://az-learner.firebaseapp.com; img-src 'self' data: blob: https://storage.googleapis.com https://*.googleusercontent.com https://www.gstatic.com https://www.google.com; media-src 'self' blob: https://storage.googleapis.com; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob: https://storage.googleapis.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "regex": "^/(explore|showcase|about|early-access|faq|privacy|terms)?(\\.html)?$",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "all"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
            }
          ]
        },
        {
          "source": "/embed/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; media-src 'self' https://storage.googleapis.com; connect-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'self' https://blogs.pwavwe.com https://www.blogger.com https://*.blogspot.com"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
            },
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "unsafe-none"
            },
            {
              "key": "Cross-Origin-Resource-Policy",
              "value": "cross-origin"
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex"
            }
          ]
        },
        {
          "source": "/api/public/audio/*",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=30, s-maxage=60"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'none'; frame-ancestors 'none'"
            }
          ]
        },
        {
          "source": "/api/public/audio/*/r/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'none'; frame-ancestors 'none'"
            }
          ]
        },
        {
          "source": "/api/public/early-access",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'none'; frame-ancestors 'none'"
            }
          ]
        }
      ]
    }
  ],
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "functions": {
      "port": 5001
    },
    "tasks": {
      "port": 9499
    },
    "ui": {
      "enabled": false
    }
  }
}
